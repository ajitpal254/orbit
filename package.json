{
  "build": {
    "appId": "com.orbit.app",
    "directories": {
      "output": "dist"
    },
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "nsis": {
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": true,
      "shortcutName": "Orbit"
    },
    "productName": "Orbit",
    "publish": null,
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "arch": [
            "x64"
          ],
          "target": "nsis"
        }
      ]
    }
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.4",
    "mongoose": "^9.11.4",
    "nodemailer": "10.5.0",
    "pino": "^10.4.0",
    "socket.io": "^4.8.1",
    "web-push": "^4.0.0"
  },
  "description": "Orbit \u2014 spatial voice chat for friends. Rooms, not servers; people as floating orbs.",
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "mongodb-memory-server": "^10.4.3",
    "playwright": "^1.65.0"
  },
  "engines": {
    "node": "24.x"
  },
  "main": "server.js",
  "name": "orbit",
  "scripts": {
    "desktop:dev": "electron electron/main.js",
    "desktop:dist": "node electron/sync-version.js && electron-builder --win",
    "desktop:sync-version": "node electron/sync-version.js",
    "start": "node server.js",
    "test": "node --test tests/*.test.js tests/*.test.mjs"
  },
  "version": "0.7.0"
}
